# Docker Compose only. Local development still uses apps/backend/.env and apps/frontend/.env.
# Prefer: node scripts/init-docker-env.cjs — creates random secrets without overwriting .env.
# POSTGRES_PASSWORD must be URL-safe (hex recommended); it is included in DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=8081
# Browser-facing URL, NOT the internal Docker hostname backend.
NUXT_PUBLIC_API_BASE=http://localhost:8081
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Existing idempotent seed refreshes only the base catalog, without demo accounts.
SEED_BASE_CATALOG=true
# Capacity controls apply to each backend process. Size the total pool across replicas.
DATABASE_CONNECTION_LIMIT=10
GENERATION_WORKERS=2
GENERATION_QUEUE_LIMIT=4
GENERATION_TIMEOUT_MS=45000
MAX_CONCURRENT_REQUESTS=256
# Comma-separated trusted proxy addresses/CIDRs. Keep empty without a proxy.
TRUST_PROXY=

# Billing provider connection; tariff settings live in /billing/admin.
BILLING_PAYMENT_MODE=disabled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_RETURN_URL=
YOOKASSA_RECEIPT_MODE=
YOOKASSA_VAT_CODE=
