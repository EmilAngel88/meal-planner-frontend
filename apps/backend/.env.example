DATABASE_URL=postgresql://meal_planner:local_password@localhost:5432/meal_planner?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=5001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Empty means a direct connection. For a proxy, trust its address/CIDR only.
TRUST_PROXY=
# Per API process: bounded compute concurrency and waiting jobs.
GENERATION_WORKERS=2
GENERATION_QUEUE_LIMIT=4
GENERATION_TIMEOUT_MS=45000
MAX_CONCURRENT_REQUESTS=256
SHUTDOWN_TIMEOUT_MS=30000
# DATABASE_URL defaults: connection_limit=10&pool_timeout=5&connect_timeout=5&socket_timeout=30

# Billing starts with monetization and checkout disabled in the database.
# One-time server setup; prices and quotas are edited at /billing/admin.
BILLING_PAYMENT_MODE=disabled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_RETURN_URL=http://localhost:3000/billing
# provider: include receipt data; external: receipts are handled by your separate configured process.
YOOKASSA_RECEIPT_MODE=
# Required with receipt mode provider. Use your actual tax configuration (codes 1..12).
YOOKASSA_VAT_CODE=
