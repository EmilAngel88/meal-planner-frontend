{
  "name": "meal-planner-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "build": "npm --prefix apps/backend run build && npm --prefix apps/frontend run build",
    "typecheck": "npm --prefix apps/backend run typecheck && npm --prefix apps/frontend run typecheck",
    "seed": "npm run seed -w @meal-planner/backend",
    "prisma": "npm run prisma -w @meal-planner/backend",
    "predev": "node scripts/check-node.cjs",
    "preinstall": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs",
    "pretypecheck": "node scripts/check-node.cjs",
    "test": "npm --prefix apps/backend test && npm --prefix apps/frontend test",
    "test:integration": "npm --prefix apps/backend run test:integration",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "npm run prisma -- migrate deploy",
    "db:generate": "npm run prisma -- generate",
    "preseed": "node scripts/check-node.cjs",
    "preprisma": "node scripts/check-node.cjs",
    "db:backup": "node scripts/backup-db.cjs",
    "test:capacity": "npm run test:capacity -w @meal-planner/backend"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "prisma": "6.19.3",
    "rolldown": "1.2.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
